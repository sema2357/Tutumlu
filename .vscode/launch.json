{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PriceAggregator.Api (Web & Frontend)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/PriceAggregator.Api/bin/Debug/net10.0/PriceAggregator.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/PriceAggregator.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "PriceAggregator.Worker",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/PriceAggregator.Worker/bin/Debug/net10.0/PriceAggregator.Worker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/PriceAggregator.Worker",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  ]
}
