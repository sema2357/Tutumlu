{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=PriceAggregatorDB;User Id=sa;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "DefaultIndex": "tutumlu_products",
    "Username": "elastic",
    "Password": "YOUR_ELASTIC_PASSWORD",
    "EnableFailSafeFallback": true
  },
  "Jwt": {
    "Secret": "YOUR_SUPER_SECRET_JWT_KEY_MINIMUM_32_CHARACTERS_LONG",
    "Issuer": "PriceAggregatorApi",
    "Audience": "PriceAggregatorFrontend",
    "ExpiresMinutes": 10080
  }
}
