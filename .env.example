# ===================================================================
# Tutumlu Price Aggregator - Environment Configuration Example
# Kendi ortamınıza göre kopyalayıp .env olarak kaydediniz:
# cp .env.example .env
# ===================================================================

# Microsoft SQL Server (sa kullanıcısı parolası)
MSSQL_SA_PASSWORD=YourStrongPassword2026!

# Elasticsearch (elastic kullanıcısı parolası)
ELASTIC_PASSWORD=YourElasticPassword2026!

# JWT Secret Key (En az 32 karakter olmalıdır)
JWT_SECRET=YourSuperSecureJwtSecretKeyMustBeAtLeast32CharsLong!
